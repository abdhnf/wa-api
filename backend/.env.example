# Initial Super Admin (Auto-seeded on fresh install if database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Server Configuration
PORT=3100
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_hex_key_here

# Storage Paths
DB_PATH=./data/wa.db
SESSIONS_DIR=./data/auth

# Cloudflare Turnstile (Optional - for bot protection)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Google OAuth 2.0 (Optional - for SSO login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anti-Ban Engine Parameters (Optional overrides)
ANTIBAN_WARMUP_DAYS=7
ANTIBAN_MIN_DELAY_MS=3000
ANTIBAN_MAX_DELAY_MS=12000
ANTIBAN_TIMELOCK_MINUTES=463

# Basis URL panel — dipakai untuk menyusun tautan reset password di email.
# Harus alamat yang bisa dibuka pengguna dari perangkatnya, bukan localhost.
PANEL_BASE_URL=http://172.30.30.229:5174

# Email / SMTP untuk reset password.
#
# CATATAN: kunci di bawah TIDAK dibaca dari .env. Ini hanya dokumentasi —
# konfigurasi sebenarnya disimpan di tabel `settings` (diatur dari panel,
# Settings > Email) atau di berkas terpisah ~/.config/wa-api/mail.env
# (mode 0600) yang diisi lewat scripts/set-smtp-config.mjs.
#
# Urutan prioritas: tabel settings > berkas mail.env > nilai bawaan kode.
# Jadi mengisi .env di sini tidak akan berpengaruh.
#
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=xxxxxxx@smtp-brevo.com
# MAIL_PASS=
# MAIL_FROM_ADDRESS=noreply@mail.srvx.my.id
# MAIL_FROM_NAME=SRVX Apps
# MAIL_RESET_TTL_MINUTES=30
