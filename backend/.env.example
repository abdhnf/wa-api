# Initial Super Admin (Auto-seeded on fresh install if database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Server Configuration
PORT=3100
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_hex_key_here

# Storage Paths
DB_PATH=./data/wa.db
SESSIONS_DIR=./data/auth

# Cloudflare Turnstile (Optional - for bot protection)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Google OAuth 2.0 (Optional - for SSO login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anti-Ban Engine Parameters (Optional overrides)
ANTIBAN_WARMUP_DAYS=7
ANTIBAN_MIN_DELAY_MS=3000
ANTIBAN_MAX_DELAY_MS=12000
ANTIBAN_TIMELOCK_MINUTES=463
